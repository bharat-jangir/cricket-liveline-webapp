# Browser-visible API base (gateway), must end with /api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Optional: server-side API base (e.g. internal network URL). Defaults to NEXT_PUBLIC_API_URL
# API_URL=http://gateway:5000/api
# Optional: websocket origin. Defaults to NEXT_PUBLIC_API_URL without /api
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
